<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- .NET 10 ships blazor.web.js in a separate package (Microsoft.AspNetCore.App.Internal.Assets), which restore
         only adds when it sees .razor files. The Dockerfile restores from project files alone, so say so here, or the
         image has no _framework/blazor.web.js and no page becomes interactive. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <!-- Lifts MailKit's transitive 10.0.0, which has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scheduler.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scheduler.Core\Scheduler.Core.csproj" />
    <ProjectReference Include="..\Scheduler.Data\Scheduler.Data.csproj" />
    <ProjectReference Include="..\Scheduler.ServiceDefaults\Scheduler.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

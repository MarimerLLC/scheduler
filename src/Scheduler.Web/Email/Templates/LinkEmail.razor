@* An email about the recipient's own account: confirming an address, signing in, a request to organize.
   The button, the closing line and a link after it are optional. *@

<EmailFrame Title="@Subject">
    @foreach (var paragraph in Paragraphs)
    {
        <p style="margin:0 0 16px;">@paragraph</p>
    }
    @if (!string.IsNullOrEmpty(ActionUrl))
    {
        <p style="margin:24px 0;">
            <a href="@ActionUrl" style="display:inline-block;padding:10px 20px;background:#0969da;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">@ActionLabel</a>
        </p>
    }
    @if (!string.IsNullOrEmpty(Closing))
    {
        <p style="margin:0;font-size:14px;color:#59636e;">
            @Closing
            @if (!string.IsNullOrEmpty(ClosingLinkUrl))
            {
                <a href="@ClosingLinkUrl" style="color:#0969da;">@ClosingLinkLabel</a>
            }
        </p>
    }
</EmailFrame>

@code {
    [Parameter, EditorRequired] public string Subject { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<string> Paragraphs { get; set; } = [];
    [Parameter] public string? ActionUrl { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public string? Closing { get; set; }
    [Parameter] public string? ClosingLinkUrl { get; set; }
    [Parameter] public string? ClosingLinkLabel { get; set; }
}

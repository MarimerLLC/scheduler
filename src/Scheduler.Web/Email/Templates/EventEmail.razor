@* One email about a scheduling event: invitation, new times, it's set, cancelled, everyone has responded.
   The same content as the plain-text body (PlainTextEmailComposer), which agents read. Text the organizer
   wrote (title, description, reason) is shown as quoted data. *@

<EmailFrame Title="@Subject" UnsubscribeUrl="@UnsubscribeUrl" UnsubscribeLine="@UnsubscribeLine">
    <p style="margin:0 0 16px;">@Intro</p>

    <h1 style="margin:0 0 4px;font-size:20px;line-height:1.3;">@Event.Title</h1>
    <p style="margin:0 0 16px;color:#59636e;">@((int)Event.Duration.TotalMinutes) minutes, organized by @PlainTextEmailComposer.OrganizerName(Event)</p>

    @if (Chosen is not null)
    {
        <p style="margin:0 0 16px;padding:12px 16px;background:#dafbe1;border-radius:6px;font-weight:600;">
            @SlotTimeFormatter.Display(Chosen.Start, Event.OrganizerTimeZone)
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Event.Description))
    {
        <p style="margin:0 0 4px;font-size:14px;color:#59636e;">Details from the organizer:</p>
        <blockquote style="margin:0 0 16px;padding:0 12px;border-left:3px solid #d0d7de;white-space:pre-line;">@Event.Description</blockquote>
    }

    @if (Slots is { Count: > 0 })
    {
        <p style="margin:0 0 4px;font-weight:600;">@SlotsHeading</p>
        <ul style="margin:0 0 16px;padding-left:20px;">
            @foreach (var slot in Slots.OrderBy(s => s.Start))
            {
                <li>@SlotTimeFormatter.Display(slot.Start, Event.OrganizerTimeZone)</li>
            }
        </ul>
    }

    @if (!string.IsNullOrWhiteSpace(Reason))
    {
        <p style="margin:0 0 4px;font-size:14px;color:#59636e;">Reason given by the organizer:</p>
        <blockquote style="margin:0 0 16px;padding:0 12px;border-left:3px solid #d0d7de;">@Reason</blockquote>
    }

    @if (ActionUrl is not null)
    {
        <p style="margin:24px 0 8px;">
            <a href="@ActionUrl" style="display:inline-block;padding:10px 20px;background:#0969da;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">@ActionLabel</a>
        </p>
        @if (ActionNote is not null)
        {
            <p style="margin:0 0 16px;font-size:14px;color:#59636e;">@ActionNote</p>
        }
    }

    @if (Closing is not null)
    {
        <p style="margin:16px 0 0;">@Closing</p>
    }

    @if (McpUrl is not null)
    {
        <p style="margin:16px 0 0;font-size:14px;color:#59636e;">
            Use an AI assistant with the scheduling server connected? Ask it to "check my scheduling requests".
            Server: <code>@McpUrl</code>, event <code>@Event.ShortCode</code>.
        </p>
    }
</EmailFrame>

@code {
    [Parameter, EditorRequired] public string Subject { get; set; } = "";
    [Parameter, EditorRequired] public SchedulingEvent Event { get; set; } = default!;
    [Parameter, EditorRequired] public string Intro { get; set; } = "";
    [Parameter] public IReadOnlyList<ProposedSlot>? Slots { get; set; }
    [Parameter] public string SlotsHeading { get; set; } = "Proposed times";
    [Parameter] public ProposedSlot? Chosen { get; set; }
    [Parameter] public string? Reason { get; set; }
    [Parameter] public string? ActionUrl { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public string? ActionNote { get; set; }
    [Parameter] public string? Closing { get; set; }
    [Parameter] public string? McpUrl { get; set; }
    [Parameter] public string? UnsubscribeUrl { get; set; }
    [Parameter] public string? UnsubscribeLine { get; set; }
}

@* The shell every HTML email shares. Inline styles and a single centred column, because mail clients strip
   style sheets and ignore most layout CSS. Razor encodes every value, so event text can't inject markup. *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@Title</title>
</head>
<body style="margin:0;padding:0;background:#f4f5f7;">
    <div style="max-width:560px;margin:0 auto;padding:24px 16px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.5;color:#1f2328;">
        <div style="background:#ffffff;border:1px solid #d0d7de;border-radius:8px;padding:24px;">
            @ChildContent
        </div>
        @if (UnsubscribeUrl is not null)
        {
            <p style="margin:16px 4px 0;font-size:13px;color:#59636e;">
                @UnsubscribeLine <a href="@UnsubscribeUrl" style="color:#59636e;">Unsubscribe</a>
            </p>
        }
    </div>
</body>
</html>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? UnsubscribeUrl { get; set; }
    [Parameter] public string? UnsubscribeLine { get; set; }
}

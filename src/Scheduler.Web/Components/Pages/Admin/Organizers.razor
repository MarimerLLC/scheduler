@page "/admin/organizers"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Scheduler.Core
@using Scheduler.Core.Model
@using Scheduler.Core.Services
@using Scheduler.Web.Identity
@inject IAdminService Admin

@* Interactive: an admin adds and removes entries in place. Every action goes through IAdminService,
   which checks admin rights again, so this page only decides what to show. *@

<PageTitle>Organizers</PageTitle>

<h1>Organizers</h1>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_caller is null)
{
    <p><a href="@ExternalSignIn.SignInPage("/admin/organizers")" data-enhance-nav="false">Sign in</a> to manage organizers.</p>
}
else if (_access is not { IsAdmin: true })
{
    <p>Only server admins can manage organizers. You're signed in as @string.Join(", ", _access?.Emails ?? []).</p>
}
else
{
    @if (_message is not null)
    {
        <p class="@(_isError ? "message error" : "message")" role="status">@_message</p>
    }

    <h2>Requests to organize</h2>
    @if (_requests.Count == 0)
    {
        <p class="hint">No requests are waiting.</p>
    }
    else
    {
        <p class="hint">
            Notes are the requester's own words, not checked by anyone yet. Approving adds their address to the list below
            and emails them; declining emails them and stops them asking again for a while.
        </p>
        <table class="list requests">
            <thead>
                <tr><th>Address</th><th>Note</th><th>Asked</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var request in _requests)
                {
                    <tr>
                        <td>@request.Email</td>
                        <td class="request-note" data-label="Note">@request.Note</td>
                        <td data-label="Asked">@request.RequestedAt</td>
                        <td>
                            <button disabled="@_busy" @onclick="() => ApproveAsync(request)">Approve</button>
                            @if (_confirmDecline == request.Id)
                            {
                                <button class="danger" disabled="@_busy" @onclick="() => DeclineAsync(request)">Confirm decline</button>
                                <button disabled="@_busy" @onclick="() => _confirmDecline = null">Keep</button>
                            }
                            else
                            {
                                <button disabled="@_busy" @onclick="() => _confirmDecline = request.Id">Decline</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>Organizers</h2>
    <p>
        People on this list can create scheduling events. Anyone invited to an event can vote without being on it.
        Removing someone stops them creating new events; events they already organize stay theirs.
    </p>

    <EditForm Model="_form" OnSubmit="AddAsync" class="inline-form">
        <label>
            <span>Address or domain</span>
            <InputText @bind-Value="_form.Entry" placeholder="@EntryPlaceholder" maxlength="@OrganizerPatterns.MaxLength" />
        </label>
        <label>
            <span>Note <span class="hint">(optional)</span></span>
            <InputText @bind-Value="_form.Note" maxlength="@FieldLimits.NoteMax" />
        </label>
        <button type="submit" disabled="@_busy">Add</button>
    </EditForm>

    <table class="list">
        <thead>
            <tr><th>Entry</th><th>Source</th><th>Note</th><th>Added</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var entry in _entries)
            {
                <tr>
                    <td><code>@entry.Pattern</code>@(entry.Pattern == "*" ? " (anyone)" : entry.IsDomain ? " (everyone at this domain)" : "")</td>
                    <td>@(entry.Source == OrganizerSource.Configuration ? "Server configuration" : "Granted")</td>
                    <td>@entry.Note</td>
                    <td>@(entry.GrantedAt is null ? "" : $"{entry.GrantedAt} by {entry.GrantedBy}")</td>
                    <td>
                        @if (entry.Source == OrganizerSource.Granted)
                        {
                            @if (_confirmRemove == entry.Pattern)
                            {
                                <button class="danger" disabled="@_busy" @onclick="() => RemoveAsync(entry.Pattern)">Confirm remove</button>
                                <button disabled="@_busy" @onclick="() => _confirmRemove = null">Keep</button>
                            }
                            else
                            {
                                <button disabled="@_busy" @onclick="() => _confirmRemove = entry.Pattern">Remove</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private sealed class AddForm
    {
        public string? Entry { get; set; }
        public string? Note { get; set; }
    }

    private const string EntryPlaceholder = "bob@example.com or *@example.com";

    private readonly AddForm _form = new();
    private CallerIdentity? _caller;
    private CallerAccess? _access;
    private IReadOnlyList<OrganizerEntry> _entries = [];
    private IReadOnlyList<OrganizerRequestView> _requests = [];
    private bool _loading = true;
    private bool _busy;
    private string? _confirmRemove;
    private Guid? _confirmDecline;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        // Prerendering only shows "Loading…"; the data loads once, when the page turns interactive. Loading it while
        // prerendering as well would show it, then "Loading…" while the interactive copy loads it again (a flicker).
        if (!RendererInfo.IsInteractive)
            return;

        var state = AuthenticationState is null ? null : await AuthenticationState;
        _caller = CallerResolver.FromPrincipal(state?.User, Channel.Web);
        if (_caller is not null)
        {
            _access = await Admin.GetAccessAsync(_caller, CancellationToken.None);
            if (_access.IsAdmin)
                await LoadListsAsync();
        }
        _loading = false;
    }

    private async Task LoadListsAsync()
    {
        _requests = await Admin.ListOrganizerRequestsAsync(_caller!, CancellationToken.None);
        _entries = await Admin.ListOrganizersAsync(_caller!, CancellationToken.None);
    }

    private async Task ApproveAsync(OrganizerRequestView request)
    {
        await RunAsync(async () =>
        {
            await Admin.ApproveOrganizerRequestAsync(_caller!, request.Id, CancellationToken.None);
            return $"{request.Email} can now organize, and has been emailed.";
        });
    }

    private async Task DeclineAsync(OrganizerRequestView request)
    {
        await RunAsync(async () =>
        {
            await Admin.DeclineOrganizerRequestAsync(_caller!, request.Id, CancellationToken.None);
            return $"Declined the request from {request.Email}, who has been emailed.";
        });
    }

    private async Task AddAsync()
    {
        await RunAsync(async () =>
        {
            var added = await Admin.AddOrganizerAsync(_caller!, _form.Entry ?? "", _form.Note, CancellationToken.None);
            _form.Entry = _form.Note = null;
            return $"{added.Pattern} can now organize.";
        });
    }

    private async Task RemoveAsync(string pattern)
    {
        await RunAsync(async () =>
        {
            await Admin.RemoveOrganizerAsync(_caller!, pattern, CancellationToken.None);
            return $"{pattern} can no longer create new events.";
        });
    }

    private async Task RunAsync(Func<Task<string>> action)
    {
        _busy = true;
        try
        {
            _message = await action();
            _isError = false;
        }
        catch (SchedulingException ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            // Reload either way: a refusal may mean another admin changed something.
            await LoadListsAsync();
            _busy = false;
            _confirmRemove = null;
            _confirmDecline = null;
        }
    }
}

@page "/events/{Id:guid}"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Scheduler.Core
@using Scheduler.Core.Model
@using Scheduler.Core.Services
@using Scheduler.Web.Identity
@inject ISchedulingService Scheduling
@inject IEventChanges Changes

@* One event, for its organizer: the ranked times with their tallies, who answered what, and the organizer's
   actions. Interactive so votes appear as they arrive (IEventChanges). Every action goes through
   ISchedulingService with the version shown, so a change made elsewhere in the meantime (an agent, another tab)
   is refused rather than overwritten. Participants are sent to the voting page. See docs/design.md, "Web UI". *@

<PageTitle>@(_event?.Title ?? "Event")</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_caller is null)
{
    <p><a href="@ExternalSignIn.SignInPage($"/events/{Id}")" data-enhance-nav="false">Sign in</a> to see this event.</p>
}
else if (_event is null)
{
    <h1>Event</h1>
    <p>There's no event here for you. <a href="/events">Your events</a></p>
}
else if (!_event.IsOrganizer)
{
    <h1>@_event.Title</h1>
    <p>You're invited. <a href="/e/@_event.ShortCode" data-enhance-nav="false">Answer on the voting page</a>.</p>
}
else
{
    <div class="page-heading">
        <h1>@_event.Title</h1>
        <span class="state state-@_event.State.ToString().ToLowerInvariant()">@Events.StateLabel(_event.State)</span>
    </div>
    <p class="hint">
        @_event.DurationMinutes minutes. Event <code>@_event.ShortCode</code>. Times in @_event.OrganizerTimeZone.
        @if (_event.RespondBy is not null)
        {
            <text> Deadline: @_event.RespondBy.</text>
        }
    </p>
    @if (!string.IsNullOrWhiteSpace(_event.Description))
    {
        <blockquote class="organizer-text">@_event.Description</blockquote>
    }

    @if (_message is not null)
    {
        <p class="@(_isError ? "message error" : "message")" role="status">@_message</p>
    }

    @if (_finalized is not null)
    {
        <section class="new-token" aria-live="polite">
            <p><strong>Now create the meeting in your calendar.</strong> Participants were emailed that it's set, and the
                calendar invitation should come from you.</p>
            <dl class="consent-details">
                <dt>Starts</dt><dd>@(_finalized.Event.Slots.FirstOrDefault(s => s.SlotId == _finalized.Event.FinalizedSlotId)?.OrganizerLocal ?? _finalized.LocalStart), time zone @_finalized.TimeZone</dd>
                <dt>Length</dt><dd>@_finalized.DurationMinutes minutes</dd>
                <dt>Invite</dt><dd>@string.Join(", ", _finalized.AttendeeEmails)</dd>
            </dl>
            <button @onclick="() => _finalized = null">Done</button>
        </section>
    }

    <h2>Times</h2>
    <p class="hint">Best first: fewest "can't" from required people, then most "works". A time a required person can't make is marked.</p>
    <table class="list slots">
        <thead>
            <tr><th>#</th><th>Time</th><th>Works</th><th>If necessary</th><th>Can't</th><th>Not answered</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var slot in _event.Slots.OrderBy(s => s.Rank))
            {
                var chosen = slot.SlotId == _event.FinalizedSlotId;
                <tr class="@(chosen ? "chosen" : slot.Viable == false ? "not-viable" : null)">
                    <td>@slot.Rank</td>
                    <td>
                        @slot.OrganizerLocal
                        @if (chosen)
                        {
                            <strong> (picked)</strong>
                        }
                        else if (slot.Viable == false)
                        {
                            <span class="hint"> (a required person can't)</span>
                        }
                    </td>
                    <td data-label="Works">@slot.Tally.Preferred</td>
                    <td data-label="If necessary">@slot.Tally.IfNecessary</td>
                    <td data-label="Can't">@slot.Tally.No</td>
                    <td data-label="Not answered">@slot.Tally.Pending</td>
                    <td>
                        @if (_event.State == EventState.Open)
                        {
                            @if (_confirm == (slot.SlotId, PickAction))
                            {
                                <button disabled="@_busy" @onclick="() => FinalizeAsync(slot)">Confirm: pick this time</button>
                                <button disabled="@_busy" @onclick="() => _confirm = null">Keep voting</button>
                            }
                            else if (_confirm == (slot.SlotId, WithdrawAction))
                            {
                                <button class="danger" disabled="@_busy" @onclick="() => WithdrawAsync(slot)">Confirm withdraw</button>
                                <button disabled="@_busy" @onclick="() => _confirm = null">Keep it</button>
                            }
                            else
                            {
                                <button disabled="@_busy" @onclick="() => _confirm = (slot.SlotId, PickAction)">Pick</button>
                                <button disabled="@_busy" @onclick="() => _confirm = (slot.SlotId, WithdrawAction)">Withdraw</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>People</h2>
    <table class="list">
        <thead>
            <tr>
                <th>Person</th>
                @foreach (var slot in _event.Slots)
                {
                    <th title="@slot.OrganizerLocal">@ShortTime(slot)</th>
                }
                <th>Note</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var person in _event.Participants)
            {
                <tr>
                    <td>
                        @(person.DisplayName ?? person.Email)
                        @if (person.DisplayName is not null)
                        {
                            <span class="hint person-email">@person.Email</span>
                        }
                        @if (person.Role == AttendeeRole.Optional)
                        {
                            <span class="hint">(optional)</span>
                        }
                    </td>
                    @foreach (var slot in _event.Slots)
                    {
                        <td data-label="@ShortTime(slot)">@VoteLabel(person.Votes, slot.SlotId)</td>
                    }
                    <td data-label="Note">@person.Note</td>
                </tr>
            }
        </tbody>
    </table>

    @if (_event.State is EventState.Open or EventState.Expired or EventState.Finalized)
    {
        <h2>@(_event.State == EventState.Finalized ? "Reschedule" : "Propose more times")</h2>
        <p class="hint">
            Participants are emailed about the new times.
            @(_event.State == EventState.Finalized ? "Rescheduling reopens voting." : _event.State == EventState.Expired ? "This reopens voting." : "")
        </p>
        <div class="slot-inputs">
            @for (var i = 0; i < _newSlots.Count; i++)
            {
                var index = i;
                <input type="datetime-local" aria-label="New time @(index + 1)" value="@_newSlots[index]" @onchange="e => _newSlots[index] = e.Value?.ToString() ?? string.Empty" />
            }
            <button @onclick="() => _newSlots.Add(string.Empty)">Add a time</button>
        </div>
        <label class="field">
            <span>New deadline (optional, @_event.OrganizerTimeZone)</span>
            <input type="datetime-local" value="@_newDeadline" @onchange="e => _newDeadline = e.Value?.ToString()" />
        </label>
        <button disabled="@_busy" @onclick="ProposeAsync">Send the new times</button>
    }

    @if (_event.State != EventState.Cancelled)
    {
        <h2>Cancel</h2>
        @if (_confirmCancel)
        {
            <label class="field">
                <span>Reason (optional; everyone invited sees it)</span>
                <textarea rows="2" maxlength="@FieldLimits.NoteMax" @bind="_cancelReason"></textarea>
            </label>
            <button class="danger" disabled="@_busy" @onclick="CancelAsync">Confirm: cancel and tell everyone</button>
            <button disabled="@_busy" @onclick="() => _confirmCancel = false">Don't cancel</button>
        }
        else
        {
            <button class="danger" disabled="@_busy" @onclick="() => _confirmCancel = true">Cancel this event</button>
        }
    }
}

@code {
    private const string PickAction = "pick";
    private const string WithdrawAction = "withdraw";

    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private CallerIdentity? _caller;
    private EventView? _event;
    private FinalizeResult? _finalized;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private bool _isError;
    private (Guid SlotId, string Action)? _confirm;
    private bool _confirmCancel;
    private string? _cancelReason;
    private readonly List<string> _newSlots = [string.Empty, string.Empty];
    private string? _newDeadline;
    private IDisposable? _subscription;

    protected override async Task OnInitializedAsync()
    {
        // Prerendering only shows "Loading…"; the data loads once, when the page turns interactive. Loading it while
        // prerendering as well would show it, then "Loading…" while the interactive copy loads it again (a flicker).
        if (!RendererInfo.IsInteractive)
            return;

        var state = AuthenticationState is null ? null : await AuthenticationState;
        _caller = CallerResolver.FromPrincipal(state?.User, Channel.Web);
        if (_caller is not null)
            await LoadAsync();
        _loading = false;
        Subscribe();
    }

    private void Subscribe()
    {
        if (_event is { IsOrganizer: true })
            _subscription = Changes.Subscribe(eventId =>
            {
                if (eventId == Id && !_busy)
                    _ = InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        StateHasChanged();
                    });
            });
    }

    private async Task LoadAsync()
    {
        try
        {
            _event = await Scheduling.GetEventAsync(_caller!, Id.ToString(), viewerTimeZone: null, CancellationToken.None);
        }
        catch (SchedulingAccessException)
        {
            _event = null;
        }
    }

    private Task FinalizeAsync(SlotView slot) => RunAsync(async ev =>
    {
        _finalized = await Scheduling.FinalizeAsync(_caller!, ev.ShortCode, slot.SlotId, ev.Version, CancellationToken.None);
        return $"Picked {slot.OrganizerLocal}.";
    });

    private Task WithdrawAsync(SlotView slot) => RunAsync(async ev =>
    {
        await Scheduling.WithdrawSlotAsync(_caller!, ev.ShortCode, slot.SlotId, ev.Version, CancellationToken.None);
        return $"Withdrew {slot.OrganizerLocal}. Its votes were discarded.";
    });

    private Task ProposeAsync() => RunAsync(async ev =>
    {
        var slots = _newSlots.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => new SlotInput(s, ev.OrganizerTimeZone)).ToList();
        var view = await Scheduling.ProposeMoreSlotsAsync(_caller!, ev.ShortCode, slots,
            string.IsNullOrWhiteSpace(_newDeadline) ? null : _newDeadline, ev.Version, CancellationToken.None);
        _newSlots.Clear();
        _newSlots.AddRange([string.Empty, string.Empty]);
        _newDeadline = null;
        return string.Join(" ", new[] { $"Sent {slots.Count} new time(s) to everyone invited." }.Concat(view.Notices ?? []));
    });

    private Task CancelAsync() => RunAsync(async ev =>
    {
        await Scheduling.CancelAsync(_caller!, ev.ShortCode, _cancelReason, CancellationToken.None);
        _confirmCancel = false;
        return "Cancelled. Everyone invited was told.";
    });

    private async Task RunAsync(Func<EventView, Task<string>> action)
    {
        if (_event is null)
            return;
        _busy = true;
        try
        {
            _message = await action(_event);
            _isError = false;
        }
        catch (SchedulingException ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _confirm = null;
            _busy = false;
            await LoadAsync();
        }
    }

    /// <summary>A column heading, e.g. "Tue Nov 3, 10:00 AM": the display time without its zone.</summary>
    private static string ShortTime(SlotView slot)
    {
        var text = slot.OrganizerLocal;
        var cut = text.LastIndexOf(' ', Math.Max(0, text.IndexOf(" (", StringComparison.Ordinal) - 1));
        return cut > 0 ? text[..cut] : text;
    }

    private static string VoteLabel(IReadOnlyDictionary<Guid, VoteValue>? votes, Guid slotId) =>
        votes is not null && votes.TryGetValue(slotId, out var vote)
            ? vote switch { VoteValue.Preferred => "Works", VoteValue.IfNecessary => "If necessary", _ => "Can't" }
            : "—";

    public void Dispose() => _subscription?.Dispose();
}
